---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import Btn from './Btn.astro';
import keyart from '../../images/basher_beatdown/Full HD.png';
---

<section class="band">
  <Image
    class="bg"
    src={keyart}
    alt=""
    widths={[900, 1400, 1920]}
    sizes="100vw"
    loading="lazy"
    aria-hidden="true"
  />
  <div class="scrim"></div>

  <div class="wrap inner">
    <p class="eyebrow">Coming soon</p>
    <h2>Add it to your wishlist</h2>
    <p class="say">
      {site.game} is in development for {site.platforms}. Wishlist it on Steam and you'll
      hear the moment it's playable.
    </p>
    <div class="acts">
      <Btn href={site.links.steam} size="lg">Wishlist on Steam</Btn>
      <Btn href={site.links.discord} variant="ghost" size="lg">Join the Discord</Btn>
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--line);
  }

  .band :global(.bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--ink), rgba(6, 7, 11, 0.72));
  }

  .inner {
    position: relative;
    padding-block: 118px;
    text-align: center;
  }

  h2 {
    font-size: clamp(34px, 5vw, 60px);
    margin: 16px 0 20px;
  }

  .say {
    color: var(--mut);
    font-size: 17.5px;
    line-height: 1.6;
    max-width: 52ch;
    margin: 0 auto 36px;
  }

  .acts {
    display: flex;
    gap: 13px;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .inner {
      padding-block: 78px;
    }
    .say {
      font-size: 16px;
    }
  }
</style>

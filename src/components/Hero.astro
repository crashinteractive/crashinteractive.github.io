---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import Btn from './Btn.astro';

/* 2464x1412 key art with no logo baked in, so the game logo below is a real element:
   it can be sized per breakpoint and always sits above the scrim at full brightness.
   'Full HD.png' has the logo painted into the top left, which the scrim dulls to grey. */
import art from '../../images/basher_beatdown/Full HD No logo.png';
import gameLogo from '../../images/basher_beatdown/Logo.png';
---

<header class="hero" id="top">
  <Image
    class="art"
    src={art}
    alt=""
    widths={[900, 1400, 1920, 2464]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    aria-hidden="true"
  />
  <div class="scrim"></div>

  <div class="wrap inner">
    <h1 class="sr-only">{site.game}</h1>
    <Image
      class="logo"
      src={gameLogo}
      alt={site.game}
      widths={[320, 440, 880]}
      sizes="(max-width: 900px) 74vw, 440px"
      loading="eager"
    />

    <p class="tag">{site.tagline}</p>

    <div class="acts">
      <Btn href={site.links.steam} size="lg">Wishlist on Steam</Btn>
      <Btn href="#trailer" variant="ghost" size="lg">Watch the trailer</Btn>
    </div>

    <p class="plat">1 to 4 players &middot; Couch and online &middot; {site.platforms}</p>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero :global(.art) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* the brawl sits right of centre; bias the crop so it survives narrow viewports */
    object-position: 62% 42%;
  }

  /* Darkens the left so the logo and type sit on near-black while the right stays
     vivid, then blends the bottom into the page. The logo is an element above this,
     so it keeps its full brightness. */
  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(6, 7, 11, 0.93) 0%,
        rgba(6, 7, 11, 0.68) 36%,
        rgba(6, 7, 11, 0.1) 76%
      ),
      linear-gradient(0deg, var(--ink) 2%, transparent 52%);
  }

  .inner {
    position: relative;
    width: 100%;
    padding-block: 120px 84px;
  }

  .inner :global(.logo) {
    width: min(440px, 72%);
    height: auto;
    display: block;
    margin-bottom: 28px;
    filter: drop-shadow(0 12px 34px rgba(0, 0, 0, 0.65));
  }

  .tag {
    font-size: 21px;
    line-height: 1.45;
    max-width: 30ch;
    margin: 0 0 32px;
    font-weight: 500;
  }

  .acts {
    display: flex;
    gap: 13px;
    flex-wrap: wrap;
  }

  .plat {
    margin: 26px 0 0;
    color: var(--mut);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 72vh;
    }
    .inner {
      padding-block: 80px 56px;
    }
    .inner :global(.logo) {
      width: 80%;
      margin-bottom: 22px;
    }
    .tag {
      font-size: 18px;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import Btn from './Btn.astro';

/* Library Hero is used rather than Full HD because it has no logo baked into it,
   which would collide with the game logo overlaid below. */
import art from '../../images/basher_beatdown/Library Hero.png';
import gameLogo from '../../images/basher_beatdown/Logo.png';
---

<header class="hero" id="top">
  <Image
    class="art"
    src={art}
    alt=""
    widths={[900, 1400, 1920, 2560, 3840]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    aria-hidden="true"
  />
  <div class="scrim"></div>

  <div class="wrap inner">
    <h1 class="sr-only">{site.game}</h1>
    <Image
      class="logo"
      src={gameLogo}
      alt={site.game}
      widths={[320, 420, 840]}
      sizes="(max-width: 900px) 72vw, 420px"
      loading="eager"
    />

    <p class="tag">{site.tagline}</p>

    <div class="acts">
      <Btn href={site.links.steam} size="lg">Wishlist on Steam</Btn>
      <Btn href="#trailer" variant="ghost" size="lg">Watch the trailer</Btn>
    </div>

    <p class="plat">1 to 4 players &middot; Couch and online &middot; {site.platforms}</p>
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .hero :global(.art) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% center;
  }

  /* Two stacked gradients: one darkens the left so type sits on near-black while the
     right stays vivid, one blends the bottom into the page. */
  .scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(6, 7, 11, 0.95) 0%,
        rgba(6, 7, 11, 0.72) 38%,
        rgba(6, 7, 11, 0.12) 78%
      ),
      linear-gradient(0deg, var(--ink) 2%, transparent 48%);
  }

  .inner {
    position: relative;
    width: 100%;
    padding-block: 120px 84px;
  }

  .inner :global(.logo) {
    width: min(420px, 70%);
    height: auto;
    display: block;
    margin-bottom: 28px;
    filter: drop-shadow(0 12px 34px rgba(0, 0, 0, 0.65));
  }

  .tag {
    font-size: 21px;
    line-height: 1.45;
    max-width: 30ch;
    margin: 0 0 32px;
    font-weight: 500;
  }

  .acts {
    display: flex;
    gap: 13px;
    flex-wrap: wrap;
  }

  .plat {
    margin: 26px 0 0;
    color: var(--mut);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  /* The source art is 3840x1240, so it crops hard on tall viewports. Shorten the
     hero on small screens rather than cropping to a sliver of the scene. */
  @media (max-width: 900px) {
    .hero {
      min-height: 70vh;
    }
    .inner {
      padding-block: 80px 56px;
    }
    .inner :global(.logo) {
      width: 78%;
      margin-bottom: 22px;
    }
    .tag {
      font-size: 18px;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import keyart from '../../images/basher_beatdown/Full HD.png';
---

<section class="section" id="trailer">
  <div class="wrap">
    <div class="shead center">
      <p class="eyebrow">Trailer</p>
      <h2>Watch it all go wrong</h2>
      <p>
        A fast, funny physics brawl where the floor is chaos and the monster is always
        winning.
      </p>
    </div>

    <!--
      A facade, not a live embed. A standard YouTube iframe pulls roughly 1MB of player
      code on every page load and sets tracking cookies before anyone asks to watch.
      This loads one image we already own, and only swaps in the player on click.
    -->
    <div class="trailer" data-trailer data-id={site.youtubeId}>
      <Image
        src={keyart}
        alt=""
        widths={[800, 1200, 1600]}
        sizes="(max-width: 900px) 100vw, 1116px"
        loading="lazy"
        aria-hidden="true"
      />
      <button type="button" class="play">
        <span class="sr-only">Play the {site.game} trailer</span>
        <span class="tri" aria-hidden="true"></span>
      </button>
    </div>

    <p class="fallback">
      Trouble playing it?
      <a href={site.links.youtube} target="_blank" rel="noreferrer">Open the trailer on YouTube</a>.
    </p>
  </div>
</section>

<style>
  .center {
    text-align: center;
    margin-inline: auto;
  }

  .trailer {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .trailer :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.62;
    transition:
      opacity 0.3s ease,
      transform 0.5s ease;
  }
  .trailer:hover :global(img) {
    opacity: 0.78;
    transform: scale(1.02);
  }

  .trailer :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: var(--cy);
    border: 0;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: transform 0.25s ease;
    box-shadow: 0 14px 44px rgba(46, 232, 242, 0.4);
  }
  .trailer:hover .play {
    transform: scale(1.1);
  }
  .tri {
    border-left: 26px solid #04060a;
    border-top: 16px solid transparent;
    border-bottom: 16px solid transparent;
    margin-left: 7px;
  }

  .fallback {
    text-align: center;
    margin: 20px 0 0;
    color: var(--mut);
    font-size: 13.5px;
  }
  .fallback a {
    color: var(--mut);
  }
  .fallback a:hover {
    color: var(--cy);
  }

  @media (max-width: 900px) {
    .play {
      width: 62px;
      height: 62px;
    }
    .tri {
      border-left-width: 19px;
      border-top-width: 12px;
      border-bottom-width: 12px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-trailer]').forEach((box) => {
    const btn = box.querySelector('button');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const id = box.dataset.id;
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      frame.title = 'Basher Beatdown trailer';
      frame.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.allowFullscreen = true;
      box.replaceChildren(frame);
    });
  });
</script>

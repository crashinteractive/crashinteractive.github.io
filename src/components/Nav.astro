---
import { Image } from 'astro:assets';
import { site, nav } from '../data/site';
import Btn from './Btn.astro';
/* The trimmed variant. logo_white.png is 1000x1000 with the 830x417 lockup floating in
   transparent padding, so sizing it by height produced a tiny illegible square. */
import logo from '../../images/logo_white_trimmed.png';
---

<nav class="nav" aria-label="Main">
  <div class="wrap bar">
    <a class="brand" href="#top">
      <Image src={logo} alt={`${site.studio} home`} width={200} densities={[1, 2]} loading="eager" />
    </a>

    <ul class="links">
      {nav.map((n) => (
        <li><a href={n.href}>{n.label}</a></li>
      ))}
    </ul>

    <div class="acts">
      <Btn href={site.links.mailingList} variant="ghost" class="secondary">Mailing list</Btn>
      <Btn href={site.links.discord} variant="ghost" class="secondary">Discord</Btn>
      <Btn href={site.links.steam}>Wishlist on Steam</Btn>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: rgba(6, 7, 11, 0.82);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 30px;
    height: 70px;
  }

  .brand {
    display: flex;
    align-items: center;
    flex: none;
  }
  .brand :global(img) {
    height: 30px;
    width: auto;
    display: block;
  }

  .acts {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }

  .links {
    display: flex;
    gap: 28px;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }
  .links a {
    color: var(--mut);
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
    transition: color 0.18s ease;
  }
  .links a:hover {
    color: var(--tx);
  }

  /* Below 900px the links and the Discord button collapse. The Wishlist button never
     hides, which is the whole reason the nav is sticky. Both are still in the footer. */
  @media (max-width: 900px) {
    .links,
    .acts :global(.secondary) {
      display: none;
    }
    .bar {
      justify-content: space-between;
      gap: 14px;
    }
  }
</style>

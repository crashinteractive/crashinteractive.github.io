---
/**
 * "Alpha gameplay" label for captured footage.
 *
 * Used in exactly two places: the looping clip in How it plays, and the lightbox.
 * Deliberately NOT on the arena grid tiles (it would repeat four times over tiles
 * already carrying four pieces of text) and NOT on the hero or wishlist art
 * (illustrated key art, not captured footage).
 *
 * Expects a positioned parent.
 */
---

<span class="alpha">Alpha gameplay</span>

<style>
  .alpha {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 3;
    background: rgba(4, 6, 10, 0.78);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 6px 11px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mut);
    /* keeps it readable over the near-white corners of the ice and gingerbread shots */
    backdrop-filter: blur(6px);
    pointer-events: none;
  }
</style>

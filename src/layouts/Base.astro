---
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import '../styles/global.css';

import shareSrc from '../../images/basher_beatdown/Main Capsule.png';
import favSrc from '../../images/logo_trimmed.png';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;

const share = await getImage({ src: shareSrc, width: 1200, format: 'jpeg' });
const fav = await getImage({ src: favSrc, width: 64, format: 'png' });

const canonical = new URL(Astro.url.pathname, Astro.site);
const shareUrl = new URL(share.src, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: site.game,
  description: site.description,
  url: canonical.href,
  image: shareUrl.href,
  genre: ['Action', 'Indie', 'Party Game', 'Fighting'],
  gamePlatform: ['PC', 'macOS'],
  operatingSystem: ['Windows 10', 'macOS 13'],
  playMode: ['SinglePlayer', 'MultiPlayer', 'CoOp'],
  numberOfPlayers: { '@type': 'QuantitativeValue', minValue: 1, maxValue: 4 },
  trailer: { '@type': 'VideoObject', name: `${site.game} trailer`, url: site.links.youtube },
  author: {
    '@type': 'Organization',
    name: site.studio,
    url: `https://${site.domain}`,
    email: site.email,
  },
  publisher: {
    '@type': 'Organization',
    name: site.studio,
    url: `https://${site.domain}`,
    email: site.email,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={fav.src} type="image/png" />
    <meta name="theme-color" content="#06070B" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.studio} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={shareUrl.href} />
    <meta property="og:image:width" content={String(share.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(share.attributes.height ?? 688)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareUrl.href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=Archivo+Black&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <slot />
  </body>
</html>
